generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model destinos {
  id        BigInt  @id @default(autoincrement())
  actividad String?
  destino   String?
  producto  String?
  linea     String?
  plazo     String?
  programa  String?
}

model lecs {
  id      BigInt  @id @default(autoincrement())
  destino String?
  lec     String?
}
